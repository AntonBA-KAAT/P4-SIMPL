COMPILER MyLang

CHARACTERS
  letter = 'A'..'Z' + 'a'..'z'.
  digit  = '0'..'9'.

TOKENS
  ident  = letter {letter | digit}.
  number = digit {digit}.

PRODUCTIONS

MyLang = { Statement } .

Statement =
    ident "=" Expr ";"
  | "print" "(" Expr ")" ";"
.

Expr   = Term { ("+" | "-") Term } .
Term   = Factor { ("*" | "/") Factor } .
Factor =
    ident
  | number
  | "(" Expr ")"
.

END MyLang.